{
  "name": "ai-patch-apply",
  "displayName": "AI Patch Apply",
  "description": "Apply AI code changes from your chat — paste a reply with BEFORE/AFTER blocks, review each edit in a native diff, accept or reject. Works with ChatGPT, Claude, Gemini and any other chat.",
  "version": "1.0.0",
  "keywords": [
    "ai",
    "patch",
    "diff",
    "apply",
    "clipboard",
    "chatgpt",
    "claude",
    "before after",
    "code review"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiPatchApply.applyFromClipboard",
        "title": "AI Patch: %command.apply%"
      },
      {
        "command": "aiPatchApply.applyPending",
        "title": "AI Patch: %command.applyPending%"
      },
      {
        "command": "aiPatchApply.cancelPending",
        "title": "AI Patch: %command.cancelPending%"
      },
      {
        "command": "aiPatchApply.copyFailedReport",
        "title": "AI Patch: %command.copyFailedReport%"
      },
      {
        "command": "aiPatchApply.undoLastPatch",
        "title": "AI Patch: %command.undoLastPatch%"
      },
      {
        "command": "aiPatchApply.clearFailedReport",
        "title": "AI Patch: %command.clearFailedReport%"
      },
      {
        "command": "aiPatchApply.acceptCurrentDiff",
        "title": "AI Patch: %command.acceptDiff%"
      },
      {
        "command": "aiPatchApply.copyPrompt",
        "title": "AI Patch: %command.copyPrompt%"
      }
    ],
    "keybindings": [
      {
        "command": "aiPatchApply.applyFromClipboard",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      },
      {
        "command": "aiPatchApply.undoLastPatch",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      },
      {
        "command": "aiPatchApply.acceptCurrentDiff",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiPatch",
          "title": "%views.container%",
          "icon": "icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "aiPatch": [
        {
          "id": "aiPatchApply.view",
          "name": "%views.view%"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "aiPatch.afterMaxBytes": {
          "type": "number",
          "default": 20000,
          "description": "%config.afterMaxBytes%"
        },
        "aiPatch.fuzzyMatch": {
          "type": "boolean",
          "default": true,
          "description": "%config.fuzzyMatch%"
        },
        "aiPatch.pinDiffTabs": {
          "type": "boolean",
          "default": true,
          "description": "%config.pinDiffTabs%"
        },
        "aiPatch.focusFirstDiff": {
          "type": "boolean",
          "default": true,
          "description": "%config.focusFirstDiff%"
        },
        "aiPatch.failureThreshold": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "%config.failureThreshold%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-l10n": "node scripts/check-l10n.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlyoshaOlyosha/ai-patch-apply.git"
  },
  "bugs": {
    "url": "https://github.com/OlyoshaOlyosha/ai-patch-apply/issues"
  },
  "homepage": "https://github.com/OlyoshaOlyosha/ai-patch-apply#readme",
  "l10n": "./l10n"
}
